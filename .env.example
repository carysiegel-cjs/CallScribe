# Supabase (Project Settings -> API)
# On Vercel the two NEXT_PUBLIC_SUPABASE_* values default to the CallScribe project; set them
# everywhere else (local dev, CI). SUPABASE_SERVICE_ROLE_KEY is always required.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
# One key covers transcription and document writing (via AssemblyAI's LLM Gateway).
ASSEMBLYAI_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# Random string; AssemblyAI sends it back on transcript-complete webhooks.
ASSEMBLYAI_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SOLO=price_...   # $39/mo
STRIPE_PRICE_PRO=price_...    # $79/mo

# Background sweeper auth (random string)
CRON_SECRET=

# App (production must be https:// for webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
